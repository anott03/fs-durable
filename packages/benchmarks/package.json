{
  "name": "@fs-durable/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lib": "pnpm --filter fs-durable build",
    "bench": "pnpm run build:lib && node src/cli.ts --backend memory,sqlite",
    "bench:memory": "pnpm run build:lib && node src/cli.ts --backend memory",
    "bench:sqlite": "pnpm run build:lib && node src/cli.ts --backend sqlite",
    "bench:remote": "pnpm run build:lib && node src/cli.ts --backend remote",
    "dev": "pnpm run build:lib && alchemy dev",
    "deploy": "pnpm run build:lib && alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck": "pnpm run build:lib && tsc -p tsconfig.json",
    "build": "pnpm run build:lib && node scripts/build.ts"
  },
  "dependencies": {
    "effect": "^4.0.5",
    "fs-durable": "workspace:*"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.83",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@effect/platform-node": "4.0.0",
    "@types/node": "^24.19.2",
    "alchemy": "2.0.0-beta.83",
    "typescript": "^7.0.2"
  }
}
