{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fs-durable-benchmarks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "vars": { "INTERNAL_TIMING": "off" },
  "secrets": { "required": ["BENCHMARK_TOKEN"] },
  "durable_objects": {
    "bindings": [{ "name": "FS_BENCH", "class_name": "FsBench" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FsBench"] }]
}
