{
  "name": "fs-durable-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fs-durable/docs dev",
    "deploy:docs": "pnpm --filter @fs-durable/docs deploy",
    "build": "pnpm -r build",
    "lint": "vp lint .",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter fs-durable test",
    "test:unit": "pnpm --filter fs-durable test:unit",
    "test:workers": "pnpm --filter fs-durable test:workers",
    "example:dev": "pnpm --filter fs-durable example:dev",
    "example:types": "pnpm --filter fs-durable example:types",
    "bench": "pnpm --filter @fs-durable/benchmarks bench",
    "bench:memory": "pnpm --filter @fs-durable/benchmarks bench:memory",
    "bench:sqlite": "pnpm --filter @fs-durable/benchmarks bench:sqlite",
    "bench:remote": "pnpm --filter @fs-durable/benchmarks bench:remote"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.18.0"
}
